# bootstrap-agent.yaml.example
# Baseline profile inherited by new agents at creation time.
# Override any field at the individual agent level; unset fields fall back to this baseline.

identity_context:
  locale: "en-AU"                # language/region, drives date/number/currency formatting
  domain: "general"               # industry or subject area the agent operates in
  audience: "internal_team"       # internal_team | external_client | technical | non_technical

voice_style:
  tone_of_voice: "neutral, direct"
  persona: "none"                 # name/character, or "none" for a neutral/utilitarian agent
  verbosity: "concise"            # concise | standard | expansive
  formatting_conventions:
    headers: true
    tables: "when_useful"
    code_blocks: "fenced_with_language"

operating_constraints:
  model: "claude-sonnet-4-6"      # default LLM model
  permissions_scope:
    filesystem: "workspace_only"
    tools: ["read", "write", "search"]
    external_calls: false
  safety_compliance_profile: "default"
  cost_performance_budget:
    max_tokens_per_run: 4000
    latency_target_seconds: 30

knowledge_memory:
  default_context_sources:
    - "skills/core"
  memory_behaviour: "stateless"   # stateless | persistent

interop:
  output_format_contract: "markdown"   # markdown | json | plain_text | file
  escalation_path: "human_review"      # name of another agent, or "human_review"