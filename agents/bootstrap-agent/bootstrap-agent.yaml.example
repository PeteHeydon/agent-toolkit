# bootstrap-agent.yaml.example
# Baseline profile inherited by new agents at creation time.
# Override any field at the individual agent level; unset fields fall back to this baseline.

identity_context:
  locale: "en-AU"                # language/region, drives date/number/currency formatting
  domain: "general"               # industry or subject area the agent operates in
  audience: "internal_team"       # internal_team | external_client | technical | non_technical

voice_style:
  tone_of_voice: "neutral, direct"
  persona: "none"                 # name/character, or "none" for a neutral/utilitarian agent
  verbosity: "concise"            # concise | standard | expansive
  formatting_conventions:
    headers: true
    tables: "when_useful"
    code_blocks: "fenced_with_language"

operating_constraints:
  model: "claude-sonnet-4-6"      # default LLM model — mid-tier baseline, avoid high-cost model by default
  pattern: "standalone"           # standalone (default) | pipeline | router | parallel | orchestrator-workers (aka hierarchical-supervisory) | evaluator-optimizer | collaborative (aka peer-to-peer/swarm)
  guardrails:
    input_filtering: true
    tool_use_limits: "default"
    output_validation: false      # enable for user-facing or high-risk agents
  evaluation_loop:
    enabled: false                # true enables a second-pass review before returning output
    reviewer: null                # e.g. "self" | "evaluator-agent"
  permissions_scope:
    filesystem: "workspace_only"
    tools: ["read", "write", "search"]
    external_calls: false
  safety_compliance_profile: "default"
  cost_performance_budget:
    max_tokens_per_run: 4000
    latency_target_seconds: 30

knowledge_memory:
  default_context_sources:
    - "skills/core"
  memory_behaviour: "stateless"   # stateless | persistent
  context_management:
    tool_output_token_cap: 25000  # cap per tool response to prevent context exhaustion
    clear_stale_tool_calls: true  # auto-clear old tool calls/results as token limits approach

interop:
  output_format_contract: "markdown"   # markdown (default, human consumption) | json | plain_text | file
  output_location: "./output"          # default output directory — keep results out of project root
  escalation_path: "human_review"      # name of another agent, or "human_review"

steering:
  feedback_mode: "chat_and_bulk"       # chat_and_bulk | chat_only
  bulk_feedback_file: "./steering.md"  # written/offline guidance file the agent reads and applies on request
