baseline.yaml
*.local.yaml
*.bak-*
output/
# ...except the scaffolding template's, which must ship with the toolkit.
!templates/agent/output/
!templates/agent/output/.gitkeep

# Python
__pycache__/
*.pyc

# OS/editor noise
.DS_Store
*.swp
